# REDOVA — local development environment (copy to .env; never commit .env).
# Variables are documented in docs/user-management/README.md Appendix C.

NODE_ENV=development
LOG_LEVEL=info
LOG_SERVICE_NAME=redova-api
# Automatic HTTP access logs (successful health checks use debug; server failures stay visible).
LOG_AUTO_LOGGING=true

# apps/server
PORT=3001
DATABASE_URL=postgresql://redova:redova@localhost:5433/redova
REDIS_URL=redis://localhost:6380
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=change-me-to-32-random-bytes-in-base64
BETTER_AUTH_URL=http://localhost:3001
WEB_ORIGIN=http://localhost:3000
HIBP_ENABLED=true
RATE_LIMIT_ENABLED=true

# Avatars: local storage is private; files are served by authenticated API routes.
AVATAR_STORAGE=local
# Optional absolute persistent directory; default: apps/server/.data/avatars
# AVATAR_LOCAL_DIR=/var/lib/redova/avatars

# apps/worker (UM-003) — dev uses Gmail SMTP with an App Password; tests use Mailpit (localhost:1025)
EMAIL_TRANSPORT=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=REDOVA <no-reply@redova.local>
EMAIL_API_KEY=

# API E2E tests use dedicated disposable services: pnpm infra:e2e
# E2E_REDIS_URL=redis://localhost:6381
# E2E_MAILPIT_URL=http://localhost:8026
# E2E_SMTP_HOST=localhost
# E2E_SMTP_PORT=1026
# E2E_PORT=3101
