# ─────────────────────────────────────────────────────────────
# REDOVA monorepo — global .gitignore (applies to apps/* and packages/*)
# ─────────────────────────────────────────────────────────────

# Dependencies
node_modules/
.pnpm-store/
.pnp.*
.yarn/

# Build outputs
dist/
build/
out/
.next/
*.tsbuildinfo
next-env.d.ts

# Turborepo
.turbo/

# Prisma generated client (regenerated by `pnpm db:generate`)
packages/db/src/generated/

# Tests & coverage
coverage/
.nyc_output/
test-results/
junit*.xml
# API end-to-end process logs (uploaded by CI on failure)
.e2e-logs/

# Environment variables & secrets — never commit (see docs/GIT-STRATEGY.md §11)
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx

# Logs
logs/
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# Runtime / temporary
tmp/
.temp/
.cache/
.data/
*.pid
*.seed
*.pid.lock

# Docker local volumes
docker/data/
docker/volumes/

# Editors & IDEs (shared settings may be committed explicitly)
.idea/
*.swp
*.swo
*.sublime-workspace
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# Local AI tooling settings
.claude/settings.local.json

# OS files
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db
