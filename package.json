{
  "name": "redova",
  "private": true,
  "description": "REDOVA — Agentic AI Security Testing and Automated Red Teaming platform",
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration",
    "test:e2e": "turbo run test:e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "infra:up": "docker compose -f docker/docker-compose.yml --profile test up -d --wait",
    "infra:down": "docker compose -f docker/docker-compose.yml --profile test down"
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "turbo": "^2.11.10",
    "typescript": "5.9.3"
  }
}
