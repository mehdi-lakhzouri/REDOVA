{
  "name": "redova",
  "private": true,
  "description": "REDOVA — Agentic AI Security Testing and Automated Red Teaming platform",
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration --concurrency=1",
    "test:e2e": "turbo run test:e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "infra:up": "docker compose -f docker/docker-compose.yml --profile test up -d --wait",
    "infra:down": "docker compose -f docker/docker-compose.yml --profile test down",
    "prepare": "simple-git-hooks",
    "db:schema:check": "pnpm --filter @redova/auth auth:generate && git diff --exit-code --ignore-cr-at-eol -- packages/db/prisma/schema.prisma",
    "db:migrate": "pnpm --filter @redova/db db:migrate",
    "db:migrate:dev": "pnpm --filter @redova/db db:migrate:dev",
    "db:generate": "pnpm --filter @redova/db db:generate",
    "db:studio": "pnpm --filter @redova/db db:studio"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^9.39.5",
    "@types/node": "^24.19.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.4.2",
    "simple-git-hooks": "^2.14.0",
    "turbo": "^2.11.10",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^4.1.12"
  },
  "simple-git-hooks": {
    "commit-msg": "pnpm exec commitlint --edit \"$1\" && node scripts/check-attribution.mjs \"$1\""
  }
}
