{
  "name": "@redova/server",
  "version": "0.0.1",
  "description": "REDOVA REST API (NestJS) — mounts Better Auth and the REDOVA API",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main",
    "admin:promote": "node dist/cli/admin-promote.js",
    "mfa:reset": "node dist/cli/mfa-reset.js",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:jest": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config jest.config.cjs --runInBand",
    "test:jest:unit": "pnpm test:jest --selectProjects unit",
    "test:jest:integration": "pnpm test:jest --selectProjects integration",
    "test:jest:watch": "pnpm test:jest --selectProjects unit --watch",
    "test:jest:coverage": "pnpm test:jest --coverage",
    "test:integration": "vitest run -c vitest.integration.config.mts",
    "test:e2e": "vitest run -c vitest.e2e.config.mts"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.1",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/swagger": "^11.4.7",
    "@redova/auth": "workspace:*",
    "@redova/contracts": "workspace:*",
    "@redova/core": "workspace:*",
    "@redova/db": "workspace:*",
    "@redova/queue": "workspace:*",
    "@thallesp/nestjs-better-auth": "2.8.0",
    "bullmq": "^6.5.3",
    "dotenv": "^17.4.2",
    "helmet": "^8.3.0",
    "ioredis": "^5.11.1",
    "nestjs-pino": "^5.3.1",
    "nestjs-zod": "^5.5.0",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@jest/globals": "^30.5.2",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@swc/core": "^1.16.20",
    "@swc/jest": "^0.2.39",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.0.0",
    "better-auth": "1.7.14",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.0.0",
    "jest": "^30.5.2",
    "pino-pretty": "^13.2.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.20.0",
    "undici": "^7.30.1",
    "unplugin-swc": "^2.0.0",
    "vitest": "^4.1.12"
  }
}
