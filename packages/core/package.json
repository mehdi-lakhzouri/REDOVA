{
  "name": "@redova/core",
  "version": "0.0.0",
  "private": true,
  "description": "Pure business policies (no I/O): organization role ranks, assignment and management rules",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@redova/contracts": "workspace:*"
  }
}
